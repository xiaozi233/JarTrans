<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Conservative rule set: only high-consensus, low-controversy checks
     (naming / imports / basic hygiene). Styling details are owned by
     Spotless (Palantir Java Format); the two must not overlap.
     NOTE: keep this file ASCII-only - the checkstyle worker may read it
     with the platform default charset (GBK on zh-CN Windows). -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <!-- forbid tab indentation (consistent with .editorconfig) -->
    <module name="FileTabCharacter"/>

    <module name="TreeWalker">
        <!-- import hygiene -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>

        <!-- naming conventions (matching the existing code base) -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="LocalVariableName"/>
        <module name="ParameterName"/>

        <!-- basic correctness -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="ArrayTypeStyle"/>
    </module>

    <!-- no console diagnostics in main sources (logging goes through core/log;
         test sources are exempt, see checkstyleTest disablement in build) -->
    <module name="RegexpSingleline">
        <property name="format" value="System\.(out|err)\.print"/>
        <property name="message" value="System.out/err is forbidden in main sources; use core/log/Log"/>
        <property name="fileExtensions" value="java"/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="printStackTrace\s*\("/>
        <property name="message" value="printStackTrace is forbidden in main sources; use core/log/Log"/>
        <property name="fileExtensions" value="java"/>
    </module>
</module>
